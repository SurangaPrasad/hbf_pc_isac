    {
      "id": "selectionnet_training_md_unsupervised_physics_loss",
      "label": "Unsupervised physics loss: -(OMEGA * sum_rate + mean_CRB)",
      "file_type": "rationale",
      "source_file": "/home/swengapp23/OneDrive/PHD Thesis/hbf_pc_isac/SELECTIONNET_TRAINING.md",
      "source_location": "L13-L18",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "There is no ground-truth antenna-to-RF-chain assignment, so SelectionNet is trained with the same unsupervised physics loss used for the UPGA step sizes (get_sum_loss = -(OMEGA * sum_rate + mean_CRB))."
    },
    {
      "id": "selectionnet_training_md_gumbel_softmax",
      "label": "Gumbel-softmax discretization",
      "file_type": "rationale",
      "source_file": "/home/swengapp23/OneDrive/PHD Thesis/hbf_pc_isac/SELECTIONNET_TRAINING.md",
      "source_location": "L37-L40, L69-L70",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Makes the discrete antenna-to-RF-chain assignment differentiable via the reparameterization trick (Gumbel noise added to logits, then row-wise softmax); during training hard=False so gradients can flow to selnet."
    },
    {
      "id": "selectionnet_training_md_tau_annealing",
      "label": "Gumbel temperature annealing (tau 2.0 -> 0.1)",
      "file_type": "rationale",
      "source_file": "/home/swengapp23/OneDrive/PHD Thesis/hbf_pc_isac/SELECTIONNET_TRAINING.md",
      "source_location": "L39-L40, L91-L92",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "tau decays exponentially over epochs so the soft mask sharpens toward one-hot as training progresses (exploration at high tau, sharpening at low tau)."
    },
    {
      "id": "selectionnet_training_md_straight_through_estimator",
      "label": "Straight-through estimator",
      "file_type": "rationale",
      "source_file": "/home/swengapp23/OneDrive/PHD Thesis/hbf_pc_isac/SELECTIONNET_TRAINING.md",
      "source_location": "L71-L72",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "In hard mode the forward pass returns one-hot values but the backward pass keeps soft-probability gradients, making the discrete mask differentiable."
    },
    {
      "id": "selectionnet_training_md_load_balancing_regularizer",
      "label": "Load-balancing regularizer",
      "file_type": "concept",
      "source_file": "/home/swengapp23/OneDrive/PHD Thesis/hbf_pc_isac/SELECTIONNET_TRAINING.md",
      "source_location": "L50-L52",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Optional term loss += SELNET_LOAD_BALANCE_WEIGHT * selnet.column_load(S).std(dim=-1).mean(); off by default (weight 0.0)."
    },
    {
      "id": "selectionnet_training_md_learned_mask",
      "label": "Learned per-sample sub-connected mask",
      "file_type": "rationale",
      "source_file": "/home/swengapp23/OneDrive/PHD Thesis/hbf_pc_isac/SELECTIONNET_TRAINING.md",
      "source_location": "L7-L11",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "SelectionNet maps H and psi0 to connection matrix S; each row is a soft/hard distribution over RF chains and antenna n is assigned to the RF chain with the largest entry, replacing the fixed hand-built sub-connected mask."
    },
    {
      "id": "selectionnet_training_md_gradient_path",
      "label": "Gradient flow: loss -> get_sum_loss -> F_eff=F*S -> S -> gumbel_softmax -> logits -> selnet",
      "file_type": "rationale",
      "source_file": "/home/swengapp23/OneDrive/PHD Thesis/hbf_pc_isac/SELECTIONNET_TRAINING.md",
      "source_location": "L47-L49, L61-L74",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Only selnet.parameters() are updated; F and W are detached by the no_grad block; F_eff = F * S.unsqueeze(0) broadcasts the mask over the K dimension, zeroing unselected antenna-to-RF-chain paths."
    }
  ],
