% Plot objective-vs-iteration from cached Python results.
% Reproduces the Python objective plot using saved MAT cache only.

clear; clc; close all;

% --------------------------- User settings ---------------------------
Nt = 64;
OMEGA = 0.25;
system_config = sprintf('%dTX_4UE_4RF', Nt);
result_dir = fullfile('..', 'sim_results', system_config);
cache_file = fullfile(result_dir, sprintf('plot_cache_vs_iter_%d_%g.mat', Nt, OMEGA));

% --------------------------- Load cache -----------------------------
if ~isfile(cache_file)
	error('Cache file not found: %s\nRun main_iter.py once with run_program=1 first.', cache_file);
end
S = load(cache_file);

% Infer n_outer from any available fixed-J array.
n_outer = infer_n_outer(S);
iter_outer_x = 1:n_outer;

outer_idx_J4  = make_outer_idx(n_outer, 4);
outer_idx_J5  = make_outer_idx(n_outer, 5);
outer_idx_J6  = make_outer_idx(n_outer, 6);
outer_idx_J10 = make_outer_idx(n_outer, 10);

[outer_idx_J5_decay, iter_outer_x_J5_decay] = make_outer_idx_decay(S, 'inner_iter_history_UPGA_J5_decay');
[outer_idx_J10_decay, iter_outer_x_J10_decay] = make_outer_idx_decay(S, 'inner_iter_history_UPGA_J10_decay');

% -------------------------- Plot figure -----------------------------
% Match Python figsize=(8, 5.2) inches at 100 dpi
fig = figure('Color', 'w', 'Units', 'inches', 'Position', [1.5 1.5 9.5 7.7]);
hold on;
grid on;

% markevery=5 equivalent: show a marker every 5 outer iterations.
mev = 5;
% Conventional PGA J5
if has_fields(S, {'rate_iter_conv_PGA_J5', 'crb_iter_conv_PGA_J5'})
    y = OMEGA .* as_row(S.rate_iter_conv_PGA_J5) + as_row(S.crb_iter_conv_PGA_J5);
    plot(iter_outer_x, y(outer_idx_J5), ':d', ...
        Color=bluetooth, blue, 'LineWidth', 3, 'MarkerSize', 8, ...
        'MarkerIndices', 1:mev:numel(iter_outer_x), ...
        'DisplayName', 'Conv. PGA, 600 inner iterations');
end
% Conventional PGA J10
if has_fields(S, {'rate_iter_conv_PGA_J10', 'crb_iter_conv_PGA_J10'})
	y = OMEGA .* as_row(S.rate_iter_conv_PGA_J10) + as_row(S.crb_iter_conv_PGA_J10);
	plot(iter_outer_x, y(outer_idx_J10), ':o', ...
		'Color', blue, 'LineWidth', 3, 'MarkerSize', 8, ...
		'MarkerIndices', 1:mev:numel(iter_outer_x), ...
		'DisplayName', 'Conv. PGA, 1200 inner iterations');
end

% Fixed-UPGA J4
if has_fields(S, {'rate_iter_UPGA_J4', 'crb_iter_UPGA_J4'})
	y = OMEGA .* as_row(S.rate_iter_UPGA_J4) + as_row(S.crb_iter_UPGA_J4);
	plot(iter_outer_x, y(outer_idx_J4), '--', ...
		'Color', orange, 'LineWidth', 3, 'MarkerSize', 8, ...
		'DisplayName', 'Fixed-UPGA, 480 inner layers');
end

% Fixed-UPGA J5
if has_fields(S, {'rate_iter_UPGA_J5', 'crb_iter_UPGA_J5'})
	y = OMEGA .* as_row(S.rate_iter_UPGA_J5) + as_row(S.crb_iter_UPGA_J5);
	plot(iter_outer_x, y(outer_idx_J5), '--d', ...
		'Color', red, 'LineWidth', 3, 'MarkerSize', 8, ...
		'MarkerIndices', 1:mev:numel(iter_outer_x), ...
		'DisplayName', 'Fixed-UPGA, 600 inner layers');
end

% Fixed-UPGA J6
if has_fields(S, {'rate_iter_UPGA_J6', 'crb_iter_UPGA_J6'})
	y = OMEGA .* as_row(S.rate_iter_UPGA_J6) + as_row(S.crb_iter_UPGA_J6);
	plot(iter_outer_x, y(outer_idx_J6), '--s', ...
		'Color', orange, 'LineWidth', 3, 'MarkerSize', 8, ...
		'MarkerIndices', 1:mev:numel(iter_outer_x), ...
		'DisplayName', 'Fixed-UPGA, 720 inner layers');
end

% Fixed-UPGA J10
if has_fields(S, {'rate_iter_UPGA_J10', 'crb_iter_UPGA_J10'})
	y = OMEGA .* as_row(S.rate_iter_UPGA_J10) + as_row(S.crb_iter_UPGA_J10);
	plot(iter_outer_x, y(outer_idx_J10), '--o', ...
		'Color', red, 'LineWidth', 3, 'MarkerSize', 8, ...
		'MarkerIndices', 1:mev:numel(iter_outer_x), ...
		'DisplayName', 'Fixed-UPGA, 1200 inner layers');
end

% Dynamic-UPGA J5 decay
if has_fields(S, {'rate_iter_UPGA_J5_decay', 'crb_iter_UPGA_J5_decay'}) && ~isempty(outer_idx_J5_decay)
	y = OMEGA .* as_row(S.rate_iter_UPGA_J5_decay) + as_row(S.crb_iter_UPGA_J5_decay);
	plot(iter_outer_x_J5_decay, y(outer_idx_J5_decay), '-d', ...
		'Color', green, 'LineWidth', 3, 'MarkerSize', 8, ...
		'MarkerIndices', 1:mev:numel(iter_outer_x_J5_decay), ...
		'DisplayName', 'Dynamic-UPGA, 421 inner layers');
end

% Dynamic-UPGA J10 decay
if has_fields(S, {'rate_iter_UPGA_J10_decay', 'crb_iter_UPGA_J10_decay'}) && ~isempty(outer_idx_J10_decay)
	y = OMEGA .* as_row(S.rate_iter_UPGA_J10_decay) + as_row(S.crb_iter_UPGA_J10_decay);
	plot(iter_outer_x_J10_decay, y(outer_idx_J10_decay), '-', ...
		'Color', green, 'LineWidth', 3, 'MarkerSize', 8, ...
		'DisplayName', 'Dynamic-UPGA, 722 inner layers');
end

xlabel('Number of iterations/layers (I)', 'FontSize', 18);
ylabel('\omega R + log(CRLB^{-1})', 'FontSize', 18);
set(gca, 'FontSize', 14);

lgd = legend('Location', 'southoutside', 'NumColumns', 2);
lgd.Box = 'off';

% ------------------------------ Save --------------------------------
png_file = fullfile(result_dir, sprintf('objective_vs_iter_%d_%g_matlab.png', Nt, OMEGA));
eps_file = fullfile(result_dir, sprintf('objective_vs_iter_%d_%g_matlab.eps', Nt, OMEGA));
exportgraphics(gcf, png_file, 'Resolution', 300);
exportgraphics(gcf, eps_file, 'ContentType', 'vector');
fprintf('Saved MATLAB objective plot to:\n  %s\n  %s\n', png_file, eps_file);


% ============================ Helpers ============================
function tf = has_fields(S, names)
tf = all(isfield(S, names));
end

function x = as_row(v)
x = v(:).';
end

function idx = make_outer_idx(n_outer, n_inner)
idx = n_inner + 1 : (n_inner + 1) : n_outer * (n_inner + 1);
end

function [idx, xouter] = make_outer_idx_decay(S, history_name)
idx = [];
xouter = [];
if ~isfield(S, history_name)
	return;
end
hist = S.(history_name);
hist = hist(:).';
if isempty(hist)
	return;
end
pos = 0;
idx = zeros(1, numel(hist));
for i = 1:numel(hist)
	pos = pos + hist(i);
	idx(i) = pos + 1;
	pos = pos + 1;
end
xouter = 1:numel(hist);
end

function n_outer = infer_n_outer(S)
if isfield(S, 'rate_iter_UPGA_J10')
	n_outer = numel(S.rate_iter_UPGA_J10) / 11;
elseif isfield(S, 'rate_iter_conv_PGA_J10')
	n_outer = numel(S.rate_iter_conv_PGA_J10) / 11;
elseif isfield(S, 'rate_iter_UPGA_J5')
	n_outer = numel(S.rate_iter_UPGA_J5) / 6;
elseif isfield(S, 'rate_iter_UPGA_J4')
	n_outer = numel(S.rate_iter_UPGA_J4) / 5;
else
	error('Cannot infer n_outer from cache file fields.');
end
n_outer = round(n_outer);
end
